# Copy to .env for local development. Never commit .env.

# Zoho CRM. Create a Self Client in the Zoho API Console, then generate a
# refresh token with scope: ZohoCRM.modules.leads.CREATE,ZohoCRM.modules.notes.CREATE
ZOHO_CLIENT_ID=1000.QLLVPWX38FSB0M02MAWTCUG5ROAPCM
ZOHO_CLIENT_SECRET=134b8b154a4982778015bc2733756ed3a6ba942345
ZOHO_REFRESH_TOKEN=1000.8ddce83a2aa58281bcc5194c3154a3f3.6839b8a7e12a4e4a50ae685852397be7

# Data centre. UK/EU accounts use these; change both together if yours differ
# (e.g. accounts.zoho.com + www.zohoapis.com for the US).
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.eu
ZOHO_API_DOMAIN=https://www.zohoapis.eu

ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
