# Copy to .env for local development. Never commit .env.

# Resend API key used by /api/contact to email form submissions.
# Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Address submissions are delivered to.
CONTACT_TO_EMAIL=francois@sgla.co.uk

# Verified sender. Until sgla.co.uk is verified in Resend you can use
# "SGLA <onboarding@resend.dev>" for testing.
CONTACT_FROM_EMAIL=SGLA Website <hello@sgla.co.uk>
