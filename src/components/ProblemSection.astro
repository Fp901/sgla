---
import SectionHeading from './SectionHeading.astro';
import Button from './Button.astro';
import { site } from '@data/site';

const problems = [
  {
    title: 'Looks behind',
    text: "Your business has moved forward. Your website still looks like it hasn't.",
  },
  {
    title: 'Feels slow',
    text: "Customers shouldn't have to wait for your website to load or fight through clutter to find what they need.",
  },
  {
    title: 'Feels restrictive',
    text: "You shouldn't have to work around a platform just to make a simple change.",
  },
];
---

<section class="section problem" aria-labelledby="problem-title">
  <div class="container">
    <SectionHeading id="problem-title" eyebrow="Your website" narrow>
      It might be doing the job. But is it doing your business justice?
      <Fragment slot="lede">
        <p>Your business changes. Your services improve. Your reputation grows.</p>
        <p>But the website often gets left behind.</p>
        <p>
          A site that once seemed perfectly fine can become slow, dated, awkward on mobile or simply
          no longer representative of the business behind it.
        </p>
      </Fragment>
    </SectionHeading>

    <ul class="problem__list">
      {problems.map((problem, index) => (
        <li class="problem__item">
          <span class="problem__index" aria-hidden="true">
            0{index + 1}
          </span>
          <h3>{problem.title}</h3>
          <p class="muted">{problem.text}</p>
        </li>
      ))}
    </ul>

    <div class="problem__close">
      <p class="problem__close-text">
        That's usually when a rebuild makes more sense than another round of patches.
      </p>
      <Button href={site.cta.href} variant="secondary" event="cta_problem">
        Show me what you'd change
      </Button>
    </div>
  </div>
</section>

<style>
  .problem__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--grid-gap);
  }

  .problem__item {
    display: grid;
    gap: var(--space-sm);
    align-content: start;
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .problem__close {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md) var(--space-lg);
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .problem__close-text {
    max-width: 22em;
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: var(--tracking-snug);
    line-height: 1.3;
  }

  .problem__index {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    color: var(--color-muted);
    margin-bottom: var(--space-md);
  }

  @media (min-width: 48em) {
    .problem__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .problem__item {
      min-height: 15rem;
    }
  }
</style>
