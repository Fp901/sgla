---
const pillars = [
  { title: 'Fast', text: 'Built to load quickly and work beautifully on real phones.' },
  {
    title: 'Owned',
    text: 'Your domain. Your hosting. Your code. No platform holding the website hostage.',
  },
  {
    title: 'Straightforward',
    text: 'One person. One project. One clear price. No bloated agency process.',
  },
];
---

<section class="pillars" aria-label="What SGLA stands for">
  <div class="container">
    <ul class="pillars__list">
      {pillars.map((pillar) => (
        <li class="pillar">
          <h2 class="pillar__title">{pillar.title}</h2>
          <p class="pillar__text">{pillar.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .pillars {
    border-block: 1px solid var(--color-border);
    padding-block: var(--space-lg);
  }

  .pillars__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-lg) var(--grid-gap);
  }

  .pillar {
    display: grid;
    gap: var(--space-xs);
    align-content: start;
  }

  .pillar__title {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent);
    line-height: 1.5;
  }

  .pillar__text {
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: var(--tracking-snug);
    line-height: 1.35;
    max-width: 22em;
  }

  @media (min-width: 40em) {
    .pillars__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .pillar {
      padding-left: var(--space-md);
      border-left: 1px solid var(--color-border);
    }
  }
</style>
