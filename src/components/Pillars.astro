---
const pillars = [
  { title: 'Fast', lines: ['Built for phones.', 'Quick-loading.', 'No bloat.'] },
  { title: 'Owned', lines: ['Your code.', 'Your domain.', 'Your hosting.'] },
  { title: 'Straightforward', lines: ['One person.', 'One project.', 'One clear price.'] },
];
---

<section class="pillars" aria-label="What SGLA stands for">
  <div class="container">
    <ul class="pillars__list">
      {pillars.map((pillar) => (
        <li class="pillar">
          <h2 class="pillar__title">{pillar.title}</h2>
          <p class="pillar__lines">
            {pillar.lines.map((line) => (
              <span>{line}</span>
            ))}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .pillars {
    border-block: 1px solid var(--color-border);
    padding-block: var(--space-lg);
  }

  .pillars__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-lg) var(--grid-gap);
  }

  .pillar {
    display: grid;
    gap: var(--space-xs);
    align-content: start;
  }

  .pillar__title {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-accent);
    line-height: 1.5;
  }

  .pillar__lines {
    display: grid;
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: var(--tracking-snug);
    line-height: 1.3;
  }

  @media (min-width: 40em) {
    .pillars__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .pillar {
      padding-left: var(--space-md);
      border-left: 1px solid var(--color-border);
    }
  }
</style>
