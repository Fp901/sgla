---
import { site } from '@data/site';
import Button from './Button.astro';
import Logo from './Logo.astro';

const pillars = ['Fast', 'Owned', 'Straightforward'];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="eyebrow">Independent web development</p>
      <h1 id="hero-title" class="hero__title">
        Your business has moved on.<span class="hero__title-accent"> Has your website?</span>
      </h1>
      <p class="hero__lede lede">
        SGLA rebuilds outdated, slow or restrictive websites for independent businesses, giving you
        a faster, better-looking website that you actually own.
      </p>
      <div class="hero__actions">
        <Button href={site.cta.href} size="lg" event="cta_hero">
          {site.cta.label}
        </Button>
        <Button href="#how-it-works" variant="ghost" arrow="down">
          See how it works
        </Button>
      </div>
      <p class="hero__terms">
        <span>Fixed price</span>
        <span>5&ndash;8 pages</span>
        <span>Typically 2&ndash;3 weeks</span>
      </p>
      <p class="hero__brand">Websites built properly. Without the agency.</p>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <div class="browser browser--back"></div>
      <div class="browser">
        <div class="browser__bar">
          <span></span>
          <span></span>
          <span></span>
          <span class="browser__url">sgla.co.uk</span>
        </div>
        <div class="browser__body">
          <Logo height="1.1rem" class="browser__logo" />
          <ul class="browser__pillars">
            {pillars.map((pillar, index) => (
              <li style={`--i: ${index}`}>
                <span class="browser__index">0{index + 1}</span>
                {pillar}
              </li>
            ))}
          </ul>
          <div class="browser__lines">
            <span style="--w: 72%"></span>
            <span style="--w: 54%"></span>
            <span style="--w: 38%"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3.5rem, 2rem + 6vw, 8rem) clamp(4rem, 3rem + 5vw, 7rem);
    overflow: hidden;
  }

  .hero__inner {
    display: grid;
    gap: var(--space-xl) var(--grid-gap);
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: center;
  }

  .hero__copy {
    grid-column: span 12;
    display: grid;
    gap: var(--space-md);
    justify-items: start;
  }

  .hero__lede,
  .hero__actions {
    margin-top: var(--space-xs);
  }

  .hero__title {
    /* Smaller than the global h1: this headline is nine words, not five. */
    font-size: clamp(2.125rem, 1.3rem + 3.5vw, 4.5rem);
    max-width: 13em;
    /* The question is the hook, so the statement before it steps back. */
    color: var(--color-muted);
  }

  .hero__title-accent {
    color: var(--color-text);
  }

  .hero__lede {
    max-width: 30em;
  }

  .hero__terms {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.9rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-muted);
  }

  /* Separators only where the line will not wrap. */
  @media (min-width: 30em) {
    .hero__terms span + span::before {
      content: '·';
      margin-right: 0.9rem;
      color: var(--color-border-strong);
    }
  }

  .hero__brand {
    margin-top: var(--space-xs);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
    font-weight: 600;
    letter-spacing: var(--tracking-snug);
    max-width: 22em;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-md);
  }

  /* --- Visual: abstract browser composition --- */

  .hero__visual {
    grid-column: span 12;
    position: relative;
    display: none;
  }

  .browser {
    position: relative;
    container-type: inline-size;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow:
      0 1px 2px rgb(var(--shadow-color) / 0.05),
      0 30px 60px -30px rgb(var(--shadow-color) / 0.28);
    overflow: hidden;
  }

  .browser--back {
    position: absolute;
    inset: 8% -6% -8% 10%;
    background: var(--color-surface);
    border-color: transparent;
    box-shadow: none;
    border-radius: var(--radius-lg);
  }

  .browser__bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.85rem 1.1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .browser__bar > span:not(.browser__url) {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .browser__url {
    margin-left: 0.75rem;
    padding: 0.3rem 0.8rem;
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    font-size: 0.75rem;
    color: var(--color-muted);
    letter-spacing: 0.01em;
  }

  .browser__body {
    padding: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    display: grid;
    gap: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .browser :global(.browser__logo) {
    color: var(--color-text);
  }

  .browser__pillars {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.35rem;
    /* Sized to the card, so the longest word always fits on one line. */
    font-size: clamp(1.25rem, 6.4cqi, 2.5rem);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    line-height: 1.1;
    text-transform: uppercase;
  }

  .browser__pillars li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding-block: 0.35rem;
    border-bottom: 1px solid var(--color-border);
    animation: rise 500ms var(--ease-out) both;
    animation-delay: calc(80ms + var(--i) * 70ms);
  }

  .browser__pillars li:last-child {
    border-bottom: 0;
  }

  .browser__index {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    color: var(--color-accent);
    min-width: 1.5rem;
  }

  .browser__lines {
    display: grid;
    gap: 0.6rem;
  }

  .browser__lines span {
    display: block;
    width: var(--w);
    height: 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (min-width: 48em) {
    .hero__title-accent {
      display: block;
    }
  }

  @media (min-width: 64em) {
    .hero__copy {
      grid-column: span 7;
    }

    .hero__visual {
      display: block;
      grid-column: 9 / span 4;
    }
  }

  @media (min-width: 80em) {
    .hero__visual {
      grid-column: 8 / span 5;
    }
  }
</style>
