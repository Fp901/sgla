---
import { site } from '@data/site';
import Button from './Button.astro';

const pillars = ['Fast', 'Owned', 'Straightforward'];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="eyebrow">Independent web development</p>
      <h1 id="hero-title" class="hero__title">
        Websites built properly. <span class="hero__title-accent">Without the agency.</span>
      </h1>
      <p class="hero__lede lede">
        Fast, modern websites for independent businesses — replacing outdated or restrictive sites
        with something you actually own.
      </p>
      <div class="hero__actions">
        <Button href={site.cta.href} size="lg" event="cta_hero">
          {site.cta.label}
        </Button>
        <Button href="#how-it-works" variant="ghost" arrow="down">
          See how it works
        </Button>
      </div>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <div class="browser browser--back"></div>
      <div class="browser">
        <div class="browser__bar">
          <span></span>
          <span></span>
          <span></span>
          <span class="browser__url">sgla.co.uk</span>
        </div>
        <div class="browser__body">
          <p class="browser__logo">{site.name}</p>
          <ul class="browser__pillars">
            {pillars.map((pillar, index) => (
              <li style={`--i: ${index}`}>
                <span class="browser__index">0{index + 1}</span>
                {pillar}
              </li>
            ))}
          </ul>
          <div class="browser__lines">
            <span style="--w: 72%"></span>
            <span style="--w: 54%"></span>
            <span style="--w: 38%"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3.5rem, 2rem + 6vw, 8rem) clamp(4rem, 3rem + 5vw, 7rem);
    overflow: hidden;
  }

  .hero__inner {
    display: grid;
    gap: var(--space-xl) var(--grid-gap);
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: center;
  }

  .hero__copy {
    grid-column: span 12;
    display: grid;
    gap: var(--space-lg);
    justify-items: start;
  }

  .hero__title {
    max-width: 10.5em;
  }

  .hero__title-accent {
    color: var(--color-muted);
  }

  .hero__lede {
    max-width: 30em;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm) var(--space-md);
  }

  /* --- Visual: abstract browser composition --- */

  .hero__visual {
    grid-column: span 12;
    position: relative;
    display: none;
  }

  .browser {
    position: relative;
    container-type: inline-size;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow:
      0 1px 2px rgb(17 17 17 / 0.04),
      0 30px 60px -30px rgb(17 17 17 / 0.25);
    overflow: hidden;
  }

  .browser--back {
    position: absolute;
    inset: 8% -6% -8% 10%;
    background: var(--color-surface);
    border-color: transparent;
    box-shadow: none;
    border-radius: var(--radius-lg);
  }

  .browser__bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.85rem 1.1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .browser__bar > span:not(.browser__url) {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .browser__url {
    margin-left: 0.75rem;
    padding: 0.3rem 0.8rem;
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    font-size: 0.75rem;
    color: var(--color-muted);
    letter-spacing: 0.01em;
  }

  .browser__body {
    padding: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    display: grid;
    gap: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .browser__logo {
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.04em;
  }

  .browser__pillars {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.35rem;
    /* Sized to the card, so the longest word always fits on one line. */
    font-size: clamp(1.25rem, 6.4cqi, 2.5rem);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    line-height: 1.1;
    text-transform: uppercase;
  }

  .browser__pillars li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding-block: 0.35rem;
    border-bottom: 1px solid var(--color-border);
    animation: rise 500ms var(--ease-out) both;
    animation-delay: calc(80ms + var(--i) * 70ms);
  }

  .browser__pillars li:last-child {
    border-bottom: 0;
  }

  .browser__index {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    color: var(--color-accent);
    min-width: 1.5rem;
  }

  .browser__lines {
    display: grid;
    gap: 0.6rem;
  }

  .browser__lines span {
    display: block;
    width: var(--w);
    height: 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (min-width: 48em) {
    .hero__title-accent {
      display: block;
    }
  }

  @media (min-width: 64em) {
    .hero__copy {
      grid-column: span 7;
    }

    .hero__visual {
      display: block;
      grid-column: 9 / span 4;
    }
  }

  @media (min-width: 80em) {
    .hero__visual {
      grid-column: 8 / span 5;
    }
  }
</style>
