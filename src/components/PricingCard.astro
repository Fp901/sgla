---
import { pricing, site } from '@data/site';
import Button from './Button.astro';
import SectionHeading from './SectionHeading.astro';

const { standard, larger } = pricing;
---

<section class="section offer" id="pricing" aria-labelledby="offer-title">
  <div class="container offer__inner">
    <div class="offer__copy">
      <SectionHeading id="offer-title" eyebrow="The offer">
        A proper website. One clear price.
        <Fragment slot="lede">
          <p>
            No hidden extras and no tiers to decode. One price for a website built properly and
            handed over completely.
          </p>
          <p>Larger or more complex websites from {larger.price}.</p>
        </Fragment>
      </SectionHeading>
    </div>

    <div class="price-card">
      <p class="price-card__name eyebrow">{standard.name}</p>
      <p class="price-card__price">
        <span>{standard.price}</span>
        <span class="price-card__note">one project, one price</span>
      </p>
      <ul class="price-card__list">
        {standard.includes.map((item) => (
          <li>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                d="M3.5 8.5l3 3 6-7"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            {item}
          </li>
        ))}
      </ul>
      <p class="price-card__timeline">Typical project: {standard.timeline}</p>
      <Button href={site.cta.href} size="lg" event="cta_pricing" class="price-card__cta">
        Start with your website
      </Button>

      <p class="price-card__note">
        <strong>No monthly website subscription required.</strong> You own the website, so it
        doesn't stop working if you stop paying SGLA.
      </p>
    </div>
  </div>
</section>

<style>
  .offer__inner {
    display: grid;
    gap: var(--space-xl) var(--grid-gap);
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: start;
  }

  .offer__copy {
    grid-column: span 12;
  }

  .offer__copy :global(.section-heading) {
    margin-bottom: 0;
  }

  .price-card {
    grid-column: span 12;
    display: grid;
    gap: var(--space-md);
    padding: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow: 0 30px 60px -40px rgb(var(--shadow-color) / 0.34);
  }

  .price-card__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-sm);
    font-size: clamp(2.75rem, 2rem + 3vw, 4.5rem);
    font-weight: 700;
    letter-spacing: var(--tracking-tight);
    line-height: 1;
  }

  .price-card__note {
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--color-muted);
  }

  .price-card__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.4rem var(--space-md);
    padding-block: var(--space-md);
    border-block: 1px solid var(--color-border);
  }

  .price-card__list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-weight: 500;
  }

  .price-card__list svg {
    flex: none;
    margin-top: 0.45em;
    color: var(--color-accent);
  }

  .price-card__note {
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
    color: var(--color-muted);
    max-width: 40em;
  }

  .price-card__note strong {
    color: var(--color-text);
  }

  .price-card__timeline {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .price-card :global(.price-card__cta) {
    justify-self: start;
  }

  @media (min-width: 30em) {
    .price-card__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64em) {
    .offer__copy {
      grid-column: span 5;
      position: sticky;
      top: calc(var(--header-height) + var(--space-xl));
    }

    .price-card {
      grid-column: 7 / span 6;
    }
  }
</style>
