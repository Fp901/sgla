---
import SectionHeading from './SectionHeading.astro';

const comparison = [
  { before: 'Old', after: 'Rebuilt' },
  { before: 'Slow', after: 'Fast' },
  { before: 'Cluttered', after: 'Clear' },
  { before: 'Restrictive', after: 'Flexible' },
  { before: 'Platform-dependent', after: 'Your code' },
];
---

<section class="section solution" aria-labelledby="solution-title">
  <div class="container solution__inner">
    <div class="solution__copy">
      <SectionHeading id="solution-title" eyebrow="The answer">
        So rebuild it. Properly.
        <p slot="lede">
          SGLA builds custom websites from the ground up. No template to squeeze your business into.
          No bloated agency process. No platform lock-in.
        </p>
      </SectionHeading>
    </div>

    <table class="compare">
      <caption class="visually-hidden">Your current site compared with an SGLA rebuild</caption>
      <thead>
        <tr>
          <th scope="col">Current site</th>
          <th scope="col">
            <span class="visually-hidden">becomes</span>
          </th>
          <th scope="col">SGLA</th>
        </tr>
      </thead>
      <tbody>
        {comparison.map((row) => (
          <tr>
            <td class="compare__before">{row.before}</td>
            <td class="compare__arrow" aria-hidden="true">
              →
            </td>
            <td class="compare__after">{row.after}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .solution {
    background: var(--color-surface);
  }

  .solution__inner {
    display: grid;
    gap: var(--space-xl) var(--grid-gap);
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: start;
  }

  .solution__copy {
    grid-column: span 12;
  }

  .solution__copy :global(.section-heading) {
    margin-bottom: 0;
  }

  .compare {
    grid-column: span 12;
    width: 100%;
    border-collapse: collapse;
    border-top: 1px solid var(--color-border-strong);
  }

  .compare th,
  .compare td {
    padding-block: clamp(0.85rem, 0.6rem + 1vw, 1.25rem);
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    vertical-align: middle;
  }

  .compare th {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .compare td {
    font-size: clamp(1.25rem, 1rem + 1.4vw, 2rem);
    font-weight: 600;
    letter-spacing: var(--tracking-snug);
    line-height: 1.15;
  }

  .compare__before {
    color: var(--color-muted);
    text-decoration: line-through;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--color-border-strong);
  }

  .compare__arrow {
    width: 1px;
    padding-inline: var(--space-md);
    color: var(--color-accent);
    font-weight: 400 !important;
  }

  .compare th:last-child,
  .compare__after {
    text-align: right !important;
  }

  @media (min-width: 64em) {
    .solution__copy {
      grid-column: span 5;
      position: sticky;
      top: calc(var(--header-height) + var(--space-xl));
    }

    .compare {
      grid-column: 7 / span 6;
    }
  }
</style>
