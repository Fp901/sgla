---
import { site } from '@data/site';
import Button from './Button.astro';
---

<section class="final-cta theme-dark" aria-labelledby="final-cta-title">
  <div class="container final-cta__inner">
    <h2 id="final-cta-title" class="final-cta__title">
      Is your current website still doing the job?
    </h2>
    <p class="final-cta__lede lede">
      Send it over. I'll tell you what I'd keep, what I'd change and what I'd rebuild.
    </p>
    <p class="final-cta__reassure">If I don't think a rebuild is worth doing, I'll tell you.</p>
    <div class="final-cta__actions">
      <Button href={site.cta.href} size="lg" event="cta_final">
        Send me my website review
      </Button>
    </div>
  </div>
</section>

<style>
  .final-cta {
    padding-block: clamp(6rem, 4rem + 8vw, 12rem);
  }

  .final-cta__inner {
    display: grid;
    gap: var(--space-lg);
    justify-items: start;
  }

  .final-cta__title {
    max-width: 12em;
    font-size: var(--text-h1);
    font-size: clamp(2.5rem, 1.5rem + 4.5vw, 5.5rem);
  }

  .final-cta__reassure {
    font-weight: 600;
    letter-spacing: var(--tracking-snug);
    max-width: 26em;
  }

  .final-cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md) var(--space-lg);
  }
</style>
