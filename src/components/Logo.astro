---
/**
 * SGLA wordmark. Space Grotesk letterforms converted to outlines, so the logo
 * needs no second webfont and never reflows while one loads.
 *
 * The letters use currentColor and the stop uses --color-accent, so the mark
 * inverts correctly inside .theme-dark sections without a second asset.
 */
interface Props {
  /** Rendered height. Width follows the mark's own ratio. */
  height?: string;
  /** Decorative when the wrapping link already names the destination. */
  title?: string;
  class?: string;
}

const { height = '1.25rem', title, class: className } = Astro.props;
---

<svg
  class:list={['logo', className]}
  viewBox="0 0 249.5 72.8"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
  style={`height: ${height}`}
  focusable="false"
>
  <g transform="translate(-3.4 71.4)">
    <path
      d="M30.90 1.40Q22.80 1.40 16.60-1.50Q10.40-4.40 6.90-9.80Q3.40-15.20 3.40-22.80L3.40-25.60L16.40-25.60L16.40-22.80Q16.40-16.50 20.30-13.35Q24.20-10.20 30.90-10.20Q37.70-10.20 41.05-12.90Q44.40-15.60 44.40-19.80Q44.40-22.70 42.75-24.50Q41.10-26.30 37.95-27.45Q34.80-28.60 30.30-29.60L28-30.10Q20.80-31.70 15.65-34.15Q10.50-36.60 7.75-40.60Q5-44.60 5-51Q5-57.40 8.05-61.95Q11.10-66.50 16.65-68.95Q22.20-71.40 29.70-71.40Q37.20-71.40 43.05-68.85Q48.90-66.30 52.25-61.25Q55.60-56.20 55.60-48.60L55.60-45.60L42.60-45.60L42.60-48.60Q42.60-52.60 41.05-55.05Q39.50-57.50 36.60-58.65Q33.70-59.80 29.70-59.80Q23.70-59.80 20.85-57.55Q18-55.30 18-51.40Q18-48.80 19.35-47Q20.70-45.20 23.40-44Q26.10-42.80 30.30-41.90L32.60-41.40Q40.10-39.80 45.65-37.30Q51.20-34.80 54.30-30.70Q57.40-26.60 57.40-20.20Q57.40-13.80 54.15-8.95Q50.90-4.10 44.95-1.35Q39 1.40 30.90 1.40M86.90 1.40Q79.70 1.40 73.85-1.85Q68-5.10 64.55-11.35Q61.10-17.60 61.10-26.60L61.10-43.40Q61.10-56.90 68.70-64.15Q76.30-71.40 89.30-71.40Q102.20-71.40 109.25-64.55Q116.30-57.70 116.30-46L116.30-45.60L103.30-45.60L103.30-46.40Q103.30-50.10 101.75-53.10Q100.20-56.10 97.10-57.85Q94-59.60 89.30-59.60Q82.30-59.60 78.30-55.30Q74.30-51 74.30-43.60L74.30-26.40Q74.30-19.10 78.30-14.65Q82.30-10.20 89.50-10.20Q96.70-10.20 100-14Q103.30-17.80 103.30-23.60L103.30-24.60L86.70-24.60L86.70-35.80L116.30-35.80L116.30 0L104.10 0L104.10-6.70L102.30-6.70Q101.60-5 100.05-3.10Q98.50-1.20 95.40 0.10Q92.30 1.40 86.90 1.40M169.60 0L124.40 0L124.40-70L137.60-70L137.60-12L169.60-12M182.90 0L169.30 0L187.70-70L210.70-70L229.10 0L215.50 0L211.70-15.40L186.70-15.40L182.90 0M198.30-61.70L189.80-27.60L208.60-27.60L200.10-61.70"
      fill="currentColor"
    />
    <circle cx="243.4" cy="-9.5" r="9.5" fill="var(--color-accent)" />
  </g>
</svg>

<style>
  .logo {
    display: block;
    width: auto;
    /* Ratio is fixed by the viewBox; height drives the size. */
    flex: none;
  }
</style>
