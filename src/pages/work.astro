---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro from '@components/PageIntro.astro';
import ProjectCard from '@components/ProjectCard.astro';
import FinalCTA from '@components/FinalCTA.astro';
import { projects } from '@data/projects';
import { site } from '@data/site';
---

<BaseLayout
  title={`Work | ${site.name}`}
  description="Selected websites built by SGLA for independent businesses. Real projects only, with no invented case studies."
>
  <PageIntro eyebrow="Work">
    A few things I've built.
    <p slot="lede">
      Real projects, launched and in use. If you'd like to see something closer to your own line of
      work, ask and I'll send examples rather than pad this page.
    </p>
  </PageIntro>

  <section class="section work" aria-label="Projects">
    <div class="container">
      {projects.length > 0 ? (
        <div class="work-grid">
          {projects.map((project, index) => (
            <ProjectCard
              project={project}
              loading={index === 0 ? 'eager' : 'lazy'}
              headingLevel={2}
            />
          ))}
        </div>
      ) : (
        <p class="lede">Selected work is being added. Get in touch for examples.</p>
      )}
    </div>
  </section>

  <FinalCTA />
</BaseLayout>

<style>
  .work {
    padding-top: var(--space-xl);
  }
</style>
