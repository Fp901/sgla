---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageIntro from '@components/PageIntro.astro';
import ProjectCard from '@components/ProjectCard.astro';
import FinalCTA from '@components/FinalCTA.astro';
import { projects } from '@data/projects';
import { site } from '@data/site';
---

<BaseLayout
  title={`Work — ${site.name}`}
  description="Selected websites built by SGLA for independent businesses. Real projects only — no invented case studies."
>
  <PageIntro eyebrow="Work">
    A few things I've built.
    <p slot="lede">
      Real projects, launched and in use. If you'd like to see something closer to your own line of
      work, ask — I'll send examples rather than pad this page.
    </p>
  </PageIntro>

  <section class="section work" aria-label="Projects">
    <div class="container">
      {projects.length > 0 ? (
        <div class="work__grid">
          {projects.map((project, index) => (
            <ProjectCard
              project={project}
              loading={index === 0 ? 'eager' : 'lazy'}
              headingLevel={2}
            />
          ))}
        </div>
      ) : (
        <p class="lede">Selected work is being added. Email {site.email} for examples.</p>
      )}
    </div>
  </section>

  <FinalCTA />
</BaseLayout>

<style>
  .work {
    padding-top: var(--space-xl);
  }

  .work__grid {
    display: grid;
    gap: var(--space-xl) var(--grid-gap);
  }

  @media (min-width: 48em) {
    .work__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .work__grid:has(> :only-child) {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    }
  }
</style>
